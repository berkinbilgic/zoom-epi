# Outputs written by the sequence scripts (run from sequence/)
sequence/[0-9][0-9]-[A-Z][a-z][a-z]-[0-9][0-9][0-9][0-9]/
*.seq
*.mat

# The recon's k-space trajectory is tracked; other .mat files are not
!recon/trajectory/*.mat

# Raw scanner data: download into recon/data/ (see README), never commit
*.dat
recon/data/*
!recon/data/.gitkeep

# Siemens gradient-system files (MP_GPA_*.asc) are vendor-confidential.
# Keep them outside the repository.
*.asc

# MATLAB / Python artifacts
*.asv
*.m~
__pycache__/
